{
  "name": "room-calendar",
  "version": "0.1.0",
  "description": "Vue 3 Web Component library for Gantt-style PMS room calendar",
  "type": "module",
  "main": "./dist/room-calendar.umd.cjs",
  "module": "./dist/room-calendar.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/room-calendar.js",
      "require": "./dist/room-calendar.umd.cjs",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist"],
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/build-demo.mjs",
    "type-check": "vue-tsc --noEmit",
    "preview": "vite preview"
  },
  "peerDependencies": {
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vite-plugin-dts": "^3.7.0",
    "vue": "^3.4.0",
    "vue-tsc": "^2.0.0"
  }
}
